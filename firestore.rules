rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permisos para el CMS y Catálogo de Mis Delirios Ranch
    match /cms_content/{document=**} {
      allow read, write: if true;
    }
    match /housing_models/{document=**} {
      allow read, write: if true;
    }
    match /lots/{document=**} {
      allow read, write: if true;
    }
    match /leads/{leadId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /cms_versions/{versionId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
